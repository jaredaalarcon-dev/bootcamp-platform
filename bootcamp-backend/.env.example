# ── Copia este archivo como .env y completa los valores reales ─────────────
# NUNCA subas el .env a GitHub.

NODE_ENV=development
PORT=3001

# URL(s) del frontend permitidas (CORS). Varias separadas por coma.
# Obligatorio en producción, ej: https://tu-proyecto.vercel.app
FRONTEND_URL=http://localhost:3000

# Base de datos (Supabase → Project Settings → Database → Connection string)
DATABASE_URL=

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT (una cadena larga y aleatoria; obligatoria en producción)
JWT_SECRET=
JWT_EXPIRES_IN=24h

# JB Assist (IA) — clave gratis en aistudio.google.com
GEMINI_API_KEY=
# Opcionales
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# n8n (automatizaciones) — opcional. Guía: docs/N8N.md
# N8N_WEBHOOK_URL=https://tu-n8n.com/webhook/sijb-eventos
# N8N_WEBHOOK_SECRET=una-clave-larga-y-aleatoria
# N8N_API_KEY=otra-clave-larga-para-que-n8n-envie-avisos
