# Copia este archivo como .env.local y completa el valor.
# URL del backend, terminando en /v1
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# Dirección pública del sitio (para sitemap.xml, robots.txt y vistas previas al compartir).
# En producción: la URL de Vercel o tu dominio, sin "/" al final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
